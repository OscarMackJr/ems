{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "classification_prerequisites_gap_untouched": {
      "const": true
    },
    "controls": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "decision_state": {
                  "const": "RULE_PUBLISHED"
                }
              },
              "required": [
                "decision_state"
              ]
            },
            "then": {
              "properties": {
                "rule": {
                  "additionalProperties": false,
                  "properties": {
                    "combination": {
                      "const": "ALL_CONDITIONS_MUST_MATCH"
                    },
                    "conditions": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "field": {
                            "enum": [
                              "production",
                              "internet_exposed",
                              "contains_customer_data",
                              "ai_enabled"
                            ]
                          },
                          "state": {
                            "enum": [
                              "KNOWN_TRUE",
                              "KNOWN_FALSE"
                            ]
                          }
                        },
                        "required": [
                          "field",
                          "state"
                        ],
                        "type": "object"
                      },
                      "maxItems": 4,
                      "minItems": 1,
                      "type": "array"
                    }
                  },
                  "required": [
                    "combination",
                    "conditions"
                  ],
                  "type": "object"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "decision_state": {
                  "const": "NO_RULE_WILL_BE_PUBLISHED"
                }
              },
              "required": [
                "decision_state"
              ]
            },
            "then": {
              "properties": {
                "rule": {
                  "type": "null"
                }
              }
            }
          }
        ],
        "properties": {
          "authority": {
            "pattern": "^AA4-GOV-[0-9]{3}$",
            "type": "string"
          },
          "control_id": {
            "pattern": "^EMS-CTRL-[0-9]{3}$",
            "type": "string"
          },
          "decision_state": {
            "enum": [
              "RULE_PUBLISHED",
              "NO_RULE_WILL_BE_PUBLISHED"
            ]
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          },
          "rule": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "combination": {
                    "const": "ALL_CONDITIONS_MUST_MATCH"
                  },
                  "conditions": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "field": {
                          "enum": [
                            "production",
                            "internet_exposed",
                            "contains_customer_data",
                            "ai_enabled"
                          ]
                        },
                        "state": {
                          "enum": [
                            "KNOWN_TRUE",
                            "KNOWN_FALSE"
                          ]
                        }
                      },
                      "required": [
                        "field",
                        "state"
                      ],
                      "type": "object"
                    },
                    "maxItems": 4,
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "required": [
                  "combination",
                  "conditions"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "control_id",
          "decision_state",
          "authority",
          "rule",
          "reason"
        ],
        "type": "object"
      },
      "maxItems": 21,
      "minItems": 21,
      "type": "array"
    },
    "disclosure": {
      "additionalProperties": false,
      "properties": {
        "review_path": {
          "minLength": 1,
          "type": "string"
        },
        "v2_0_1_date": {
          "type": "null"
        },
        "v2_0_1_possible": {
          "const": true
        },
        "verification_path": {
          "minLength": 1,
          "type": "string"
        },
        "wr_01": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "review_path",
        "verification_path",
        "wr_01",
        "v2_0_1_possible",
        "v2_0_1_date"
      ],
      "type": "object"
    },
    "document_id": {
      "const": "EMS-DEMO3-W1-REQ-001-REPLY"
    },
    "dual_role_statement": {
      "minLength": 1,
      "type": "string"
    },
    "from_authority": {
      "additionalProperties": false,
      "properties": {
        "approver": {
          "minLength": 1,
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "type": "string"
        },
        "roles": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "approver",
        "role",
        "roles"
      ],
      "type": "object"
    },
    "hayes_side_changes_needed": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    },
    "live_resolved_count_stays_zero": {
      "const": true
    },
    "not_yet_decided": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "type": "integer"
        },
        "date": {
          "type": "null"
        },
        "state": {
          "const": "NOT_YET_DECIDED"
        }
      },
      "required": [
        "count",
        "state",
        "date"
      ],
      "type": "object"
    },
    "pin": {
      "additionalProperties": false,
      "properties": {
        "authority_id": {
          "minLength": 1,
          "type": "string"
        },
        "authority_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "digest_normalisation": {
          "const": "CRLF_TO_LF"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "publication_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "publication_record_commit": {
          "pattern": "^[0-9a-f]{7,40}$",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "publication_commit",
        "authority_id",
        "version",
        "authority_sha256",
        "manifest_sha256",
        "digest_normalisation",
        "publication_record_commit"
      ],
      "type": "object"
    },
    "published_shape": {
      "additionalProperties": false,
      "properties": {
        "authority_path": {
          "minLength": 1,
          "type": "string"
        },
        "decision_records_path": {
          "minLength": 1,
          "type": "string"
        },
        "decision_state_values": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "decision_traceability_path": {
          "minLength": 1,
          "type": "string"
        },
        "example_decided_row": {
          "type": "object"
        },
        "generated_folder": {
          "minLength": 1,
          "type": "string"
        },
        "manifest_path": {
          "minLength": 1,
          "type": "string"
        },
        "per_control_fields": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "per_control_ids_carry": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "per_control_ids_field": {
          "minLength": 1,
          "type": "string"
        },
        "schema_path": {
          "minLength": 1,
          "type": "string"
        },
        "semantics_block": {
          "minLength": 1,
          "type": "string"
        },
        "top_level_field": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "authority_path",
        "schema_path",
        "generated_folder",
        "manifest_path",
        "decision_traceability_path",
        "decision_records_path",
        "per_control_fields",
        "decision_state_values",
        "top_level_field",
        "per_control_ids_field",
        "per_control_ids_carry",
        "semantics_block",
        "example_decided_row"
      ],
      "type": "object"
    },
    "reply_date": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "request_id": {
      "const": "DEMO3-W1-REQ-001"
    },
    "request_label": {
      "const": "EMSREQ-APPLIC-RULES"
    },
    "send_condition": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "document_id",
    "request_id",
    "request_label",
    "reply_date",
    "from_authority",
    "dual_role_statement",
    "pin",
    "published_shape",
    "controls",
    "not_yet_decided",
    "hayes_side_changes_needed",
    "classification_prerequisites_gap_untouched",
    "live_resolved_count_stays_zero",
    "disclosure",
    "send_condition"
  ],
  "title": "EMS reply to Hayes Verify request DEMO3-W1-REQ-001",
  "type": "object"
}
