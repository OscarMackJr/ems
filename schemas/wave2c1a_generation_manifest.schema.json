{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "wave",
    "control_id",
    "generator_version",
    "source_count",
    "records",
    "status"
  ],
  "properties": {
    "wave": {
      "const": "2C.1a"
    },
    "control_id": {
      "const": "EMS-CTRL-072"
    },
    "source_count": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "records": {
      "type": "array",
      "minItems": 1
    }
  }
}