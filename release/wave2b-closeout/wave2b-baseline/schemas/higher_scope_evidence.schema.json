{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EMS Higher Scope Evidence",
  "type": "object",
  "required": [
    "evidence_id",
    "control_id",
    "scope",
    "authority_id",
    "status",
    "evidence_date",
    "evidence_summary",
    "evidence_references"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 3
    },
    "control_id": {
      "type": "string",
      "pattern": "^EMS-CTRL-[0-9]{3}$"
    },
    "scope": {
      "enum": [
        "EMS",
        "ORGANIZATION"
      ]
    },
    "authority_id": {
      "type": "string",
      "minLength": 2
    },
    "status": {
      "enum": [
        "PASS",
        "WARNING",
        "FAIL",
        "NOT_EVALUATED"
      ]
    },
    "evidence_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "expires_on": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_summary": {
      "type": "string",
      "minLength": 3
    },
    "evidence_references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}