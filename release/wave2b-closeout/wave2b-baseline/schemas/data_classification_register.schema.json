{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "records"
  ],
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "system_or_dataset",
          "classification_level",
          "data_owner_or_steward",
          "review_date"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "system_or_dataset": {
            "type": "string",
            "minLength": 1
          },
          "classification_level": {
            "enum": [
              "PUBLIC",
              "INTERNAL",
              "CONFIDENTIAL",
              "RESTRICTED"
            ]
          },
          "data_owner_or_steward": {
            "type": "string",
            "minLength": 1
          },
          "review_date": {
            "type": "string",
            "minLength": 8
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": false
}